# Public URL used for generated shortlinks and the OIDC callback.
BASE_URL=http://localhost:3000
PORT=3000

# Configure this callback URL in the OIDC provider:
# http://localhost:3000/oidc/callback
OIDC_DOMAIN=https://your-tenant.example.com
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me

# Local PostgreSQL container credentials. Use URL-safe values because Compose
# places these values in DATABASE_URL.
POSTGRES_DB=tetra
POSTGRES_USER=tetra
POSTGRES_PASSWORD=tetra

LOG_LEVEL=info
SHORTLINK_CLEANUP_INTERVAL=1m
