{
	"private": true,
	"name": "@tetra/client",
	"scripts": {
		"dev": "yarn watch",
		"watch": "vite build --watch --mode development",
		"dist": "vite build --mode production",
		"build": "vite build --mode development",
		"typecheck": "vue-tsc --noEmit",
		"lint": "eslint . --ext .vue,.js,.cjs,.mjs,.ts,.cts,.mts --fix --ignore-path .gitignore",
		"generate-schema": "openapi-typescript http://localhost:3000/api/openapi.json -o ./src/@types/openapi.d.ts"
	},
	"dependencies": {
		"@fontsource-variable/fira-code": "^5.2.7",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/josefin-sans": "^5.2.8",
		"@headlessui/vue": "^1.7.23",
		"@tetra/schema": "workspace:*",
		"@vueuse/components": "^13.9.0",
		"@vueuse/core": "^13.9.0",
		"@vueuse/router": "^13.9.0",
		"gsap": "^3.13.0",
		"openapi-fetch": "^0.15.0",
		"pinia": "^3.0.3",
		"vue": "^3.5.22",
		"vue-router": "^4.6.3"
	},
	"devDependencies": {
		"@rushstack/eslint-patch": "^1.14.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.1.14",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.14",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.8.1",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue/eslint-config-typescript": "^14.6.0",
		"@vue/tsconfig": "^0.8.1",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.38.0",
		"eslint-plugin-vue": "^10.5.1",
		"openapi-typescript": "^7.10.1",
		"postcss": "^8.5.6",
		"sass-embedded": "^1.93.2",
		"tailwindcss": "^4.1.14",
		"typescript": "5.9.3",
		"vite": "^7.1.10",
		"vue-eslint-parser": "^10.2.0",
		"vue-tsc": "3.1.1"
	}
}
